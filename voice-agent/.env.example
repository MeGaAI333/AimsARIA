# Port this service listens on (nginx proxies to this locally)
PORT=8091

# Public base URL Twilio and this service use to reach each other
# (e.g. https://aimsai.aimsmarketingsystems.com — same value goes into the
# send-outreach edge function as VOICE_AGENT_BASE_URL)
VOICE_AGENT_BASE_URL=https://aimsai.aimsmarketingsystems.com

# Supabase (service role key — this service writes call_recordings /
# campaign_contacts / reads voice_call_contexts directly, bypassing RLS)
SUPABASE_URL=https://vvvrhavvdwhbognfepsr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Third-party voice pipeline (Deepgram Voice Agent handles STT/Claude/TTS in one connection)
DEEPGRAM_API_KEY=

# Twilio (needed to validate/answer inbound calls to MUSE)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
