# AIMS Website Scanner — Environment Variables
# Copy this file to .env and fill in your real keys

GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: webhook URL to POST results directly into AIMS CRM
AIMS_CRM_WEBHOOK=

# Optional: if using OpenAI instead of Anthropic for scoring
# OPENAI_API_KEY=your_openai_key_here
