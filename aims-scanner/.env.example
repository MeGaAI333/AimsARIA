# AIMS Website Scanner — Environment Variables
# Copy this file to .env and fill in your real keys

GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: webhook URL to POST results directly into AIMS CRM
# Include ?org_id=<your_org_id> in the URL so leads land in the right org,
# e.g. https://<project>.supabase.co/functions/v1/scanner-webhook?org_id=aims-internal
AIMS_CRM_WEBHOOK=

# Optional: shared secret sent as the x-scanner-secret header, must match
# the SCANNER_WEBHOOK_SECRET set on the CRM's scanner-webhook Edge Function
AIMS_CRM_WEBHOOK_SECRET=

# Optional: if using OpenAI instead of Anthropic for scoring
# OPENAI_API_KEY=your_openai_key_here
